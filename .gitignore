# =========================================================================
# Unity Official Comprehensive .gitignore
# =========================================================================
# Never push autogenerated, machine-specific, or large binary cache files.
# Unity will automatically regenerate Library, Temp, and Solution files.

# --- Unity Autogenerated Directories ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- IDE & Editor Configuration (Machine-Specific) ---
# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Visual Studio Code
.vscode/

# JetBrains Rider
.idea/
/[Aa]ssets/Plugins/Editor/JetBrains*

# Android / Gradle Cache
.gradle/

# Exported / Intermediate Objects
ExportedObj/
.consulo/

# --- Unity Meta Files for Ignored Assets ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Unity Crash Reports & Logs ---
sysinfo.txt
*.log
crashlytics-build.properties

# --- Binary Builds & Installers (Use GitHub Releases instead) ---
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll
*.dylib
*.so

# --- Archives & Large Compressed Files ---
*.7z
*.zip
*.tar.gz
*.rar

# --- Addressables & StreamingAssets Auto-generated Cache ---
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Operating System Generated Files ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
